# Секретный ключ для подписи сессионной cookie (обязательно сменить в проде!)
SECRET_KEY=change-me-to-a-long-random-string

# Строка подключения к БД.
# По умолчанию (если не задать) используется SQLite: sqlite:///./vinni.db
# Для PostgreSQL (в будущем): postgresql+psycopg://user:pass@host:5432/vinni
DATABASE_URL=sqlite:///./vinni.db

# Базовый URL подписки (используется в диплинках и mock-подписках)
SUB_BASE_URL=https://sub.vinni.fyi

# Данные сид-админа (создаётся при первом запуске)
ADMIN_EMAIL=admin@vinni.fyi
ADMIN_PASSWORD=admin

# --- Реквизиты владельца / контакты (футер, оферта, политика) ---
OWNER_NAME=[Ваше ФИО]
OWNER_INN=[Ваш ИНН]
CONTACT_EMAIL=support@vinni.fyi

# Ставить true только на проде (за HTTPS)
SESSION_HTTPS_ONLY=false

# --- Окружение (development / production) ---
# production отключает тестовые функции (тестовое пополнение и подтверждение оплаты)
ENVIRONMENT=production

# --- Remnawave ---
# false => mock-режим (без обращения к панели), удобно для локальных тестов
REMNAWAVE_ENABLED=false
REMNAWAVE_BASE_URL=https://panel.vinni.fyi:8443
REMNAWAVE_API_TOKEN=ваш_новый_токен
REMNAWAVE_HWID_LIMIT=3
# 0 = безлимит по трафику
REMNAWAVE_TRAFFIC_LIMIT_BYTES=0
REMNAWAVE_TIMEOUT=15

# --- Squad UUID (группы Remnawave, соответствующие тарифам) ---
SQUAD_UUID_1M=712d3fa1-b690-4726-b86c-b5fc58e36090
SQUAD_UUID_3M=8b2d454c-c5d7-484a-9d15-d252f64f2392
SQUAD_UUID_12M=8b98050d-9ba2-4adf-ac2d-bd6f77abaf3b

# --- Пробный период (3 дня, 10 ГБ) ---
SQUAD_UUID_TRIAL=e4d80551-1781-4603-a82b-3041b377028d

# --- Telegram-бот ---
BOT_TOKEN=
BOT_USERNAME=
# Ваш Telegram ID (числовой) — кому слать отчёты и кто может банить
ADMIN_TELEGRAM_ID=0
REPORT_INTERVAL_HOURS=12
SUSPICIOUS_IP_THRESHOLD=3

# --- ЮKassa (приём платежей: СБП, QR, карты) ---
# Оставьте ключи пустыми — включится mock-режим (фейковые платежи для тестов).
YOOKASSA_ENABLED=false
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Куда вернуть пользователя после оплаты
YOOKASSA_RETURN_URL=https://vinni.fyi/dashboard
